# =============================================================================
# Passyli (باصيلي) — Environment Configuration Template
# COPY THIS FILE TO .env.local AND FILL IN YOUR SECRETS
# NEVER COMMIT .env.local OR REAL SECRETS TO GIT
# =============================================================================

# Supabase Public API (Required for Browser & SSR Client)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Supabase Server-Only Key (Required for Admin/Background tasks, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Resend Email API (Required for sending verified booking tickets and receipts)
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="Passyli <tickets@passyli.com>"

# Canonical Production URL
NEXT_PUBLIC_SITE_URL="https://passyli.com"
